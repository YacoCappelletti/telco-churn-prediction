# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env

# Data (raw data is versioned separately; derived data is reproducible)
data/raw/*.csv
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Model artifacts (large binaries, reproducible via scripts)
models/*.joblib

# Images / outputs generated by scripts are kept, but ignore OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Streamlit
.streamlit/secrets.toml

# Jupyter (not allowed in this project)
.ipynb_checkpoints/
